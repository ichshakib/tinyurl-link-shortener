# The port the API server listens on
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tinyurl
# Redis connection string for caching and rate limiting
REDIS_URL=redis://localhost:6379
# gRPC address for the URL Generation Service
URL_GEN_SERVICE_URL=localhost:50051
# Current environment (development/production)
NODE_ENV=development
