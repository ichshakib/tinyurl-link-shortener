{
  "name": "url-generation-service",
  "version": "1.0.0",
  "description": "gRPC microservice for unique short code generation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/index.js\"",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1",
    "@workspace/logger": "workspace:*",
    "@workspace/proto": "workspace:*",
    "@workspace/utils": "workspace:*",
    "nanoid": "^5.1.11",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "tsc-watch": "^7.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
